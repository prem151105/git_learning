# API Keys for LFMs
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Vector Database Configuration
VECTOR_DB_TYPE=chromadb
VECTOR_DB_URL=http://vector-db:8080

# Embedding Model
EMBEDDING_MODEL=text-embedding-3-large

# Planning and Ethics Models
PLANNING_MODEL=gpt-4-turbo
ETHICS_MODEL=gpt-4-turbo
PLANNING_APPROACH=chain-of-thought

# Browser Configuration
HEADLESS_MODE=false
BROWSER_TYPE=chromium

# Prometheus Configuration
PROMETHEUS_ENABLED=true
PROMETHEUS_PUSH_GATEWAY=pushgateway:9091
PROMETHEUS_JOB_NAME=agentic_browser

# Database Credentials
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent_password

# Grafana Configuration
GRAFANA_PASSWORD=admin

# Human Assistance Mode
# Options: review, approval, manual, autonomous
DEFAULT_HUMAN_ASSIST_MODE=review
